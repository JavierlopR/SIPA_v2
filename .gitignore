# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosetests
.toggle/
.toggle_marker
.toggle.json
.toggle_override
.toggle_override.json
.toggle_test
.toggle_test.json
.toggle_run
.toggle_run.json
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.hypothesis/
.pytest_cache/
cover/

# Translation files
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
doc/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's environment, not the project.
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be committed
#   unless deploying an application. Hence, ignore Pipfile.lock by default.
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock contains specific versions of dependencies
#   that have been locked. Customarily, this is ignored.
# poetry.lock

# pdm
#   Similar to Poetry and Pipenv, pdm.lock contains specific versions of dependencies
#   pdm.lock

# PEP 582; project local packages directory (used by PDM)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spydata

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype type checker
.pytype/

# Cython debug symbols
cython_debug/

# Streamlit config (if temporary, but we can commit it if we want custom theme, though usually best to ignore streamlit state)
.streamlit/

# IDE files
.vscode/
.idea/
*.swp
*.swo
